# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# Safe to expose to the browser: scoped by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used by scripts/seed.ts to bypass RLS when inserting sample data.
# Project Settings -> API -> service_role secret. NEVER expose this to the browser
# or commit a real value — it grants full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
